{
  "name": "@gk-ui/core",
  "version": "0.0.1",
  "description": "Lit Web Components for gk-ui",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": [
    "./dist/index.js",
    "./src/index.ts",
    "./src/button/gk-button.ts",
    "./src/button/gk-button-group.ts",
    "./src/avatar/gk-avatar.ts",
    "./src/avatar/gk-avatar-group.ts"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "@gk-ui/tokens": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@gk-ui/tokens": {
      "optional": true
    }
  }
}
